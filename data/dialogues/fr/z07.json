  "barks": {
    "start": [
      {
        "who": "brann",
        "text": "De l'eau jusqu'aux genoux, et des poissons qui ont des lances. Je regrette déjà le désert."
      },
      {
        "who": "sylwen",
        "text": "Surveille la marée : quand elle monte, le premier rang de portails se noie."
      },
      {
        "who": "sylwen",
        "text": "Ils sont de Givre et de Foudre. La Foudre contre le Givre, la Nature contre la Foudre."
      },
      {
        "who": "krag",
        "text": "Je ne sais pas nager. Alors on gagne vite.",
        "if": "s1.krag_allie"
      },
      {
        "who": "nyx",
        "text": "Toute une cité noyée… Combien d'âmes sous ces eaux ?",
        "mood": "triste"
      },
      {
        "who": "ignara",
        "text": "De l'eau. Partout. Je vous préviens : je ne suis pas d'humeur.",
        "if": "s1.ignara_allie",
        "mood": "colere"
      }
    ],
    "barrier_low": [
      {
        "who": "brann",
        "text": "La Barrière prend l'eau ! Tiens bon !"
      },
      {
        "who": "sylwen",
        "text": "Ils passent sous la marée ! Ralentis-les !"
      },
      {
        "who": "krag",
        "text": "Qu'ils viennent se noyer contre nous !",
        "if": "s1.krag_allie"
      },
      {
        "who": "ignara",
        "text": "Si la Barrière tombe, je mets le feu à cet océan.",
        "if": "s1.ignara_allie"
      }
    ],
    "half": [
      {
        "who": "sylwen",
        "text": "À moitié ! La marée tourne, nous aussi."
      },
      {
        "who": "brann",
        "text": "La moitié. Et ma barbe est trempée."
      },
      {
        "who": "nyx",
        "text": "À moitié noyés. Comme eux."
      }
    ],
    "boss_phase": [
      {
        "who": "sylwen",
        "text": "Attention aux tentacules ! Sors tes troupes du couloir !"
      },
      {
        "who": "brann",
        "text": "Il prépare un tourbillon. Envoie nos troupes ailleurs."
      },
      {
        "who": "ignara",
        "text": "Il avale nos portails ! Vise ceux qui restent.",
        "if": "s1.ignara_allie"
      }
    ],
    "echo": [
