static var _texture: ImageTexture
## Héros : apparence et race (création de personnage) ; « player » est généré à la volée.
static var _player_look: Dictionary = {}
static var _player_race := "elfe"
static var _player_key := ""
static var _player_class := "mage"
static var _frames: Dictionary = {} ## clé -> Array[Dictionary{uv: Rect2, px: Rect2i, w, h}]
static var _singles: Dictionary = {}


static func texture() -> ImageTexture:
	if _texture == null:
		_build()
	return _texture


## Image n° « index » (modulo) du sprite « name » ; « element » pour les sprites recolorés.
static func frame(name: String, element: String = "", index: int = 0) -> Dictionary:
	if _texture == null:
		_build()
	var key := name
	if RECOLOR.has(name):
		key = name + "@" + (element if ELEM.has(element) else "physique")
	var arr: Array = _frames.get(key, _frames.get("familiar@physique"))
	return arr[index % arr.size()]


static func height_m(name: String) -> float:
	if name == "player":
		return float(PlayerLook.palette(_player_look, _player_race)["height"])
	return float(HEIGHT_M.get(name, 0.7))


## Apparence du héros pour le combat ; reconstruit l'atlas si elle a changé.
static func set_player(look: Dictionary, race: String, cls: String = "mage") -> void:
	var k := PlayerLook.key(look, race) + "|" + cls
	if k == _player_key:
		return
	_player_key = k
	_player_look = look.duplicate()
	_player_race = race
	_player_class = cls
	_texture = null
	for key in _singles.keys():
		if str(key).begins_with("player#"):
			_singles.erase(key)


static func frame_count(name: String) -> int:
	if _texture == null:
		_build()
	var key := name + "@physique" if RECOLOR.has(name) else name
	return (_frames.get(key, [0]) as Array).size()


## Texture autonome d'une image de sprite (icônes de l'interface).
static func single(name: String, index: int = 0) -> ImageTexture:
	var key := "%s#%d" % [name, index]
	if not _singles.has(key):
		var imgs := _images_for(name, "")
		_singles[key] = ImageTexture.create_from_image(imgs[index % imgs.size()])
	return _singles[key]


static func _build() -> void:
	var entries: Array = [] # [key, Image]
	for img in _images_for("player", ""):
		entries.append(["player", img])
	for name in DEFS.keys():
		if RECOLOR.has(name):
			for el in ELEM.keys():
				var imgs := _images_for(str(name), str(el))
				for i in range(imgs.size()):
					entries.append([str(name) + "@" + str(el), imgs[i]])
		else:
			for img in _images_for(str(name), ""):
				entries.append([str(name), img])
	# Rangement en étagères.
	var atlas_w := 512
	var x := 1
	var y := 1
	var shelf_h := 0
	var places: Array = []
	for e in entries:
		var img: Image = e[1]
		if x + img.get_width() + 1 > atlas_w:
			x = 1
			y += shelf_h + 1
			shelf_h = 0
		places.append(Vector2i(x, y))
		x += img.get_width() + 1
		shelf_h = maxi(shelf_h, img.get_height())
	var atlas_h := 1
	while atlas_h < y + shelf_h + 2:
		atlas_h *= 2
	var atlas := Image.create_empty(atlas_w, atlas_h, false, Image.FORMAT_RGBA8)
	atlas.fill(Color(0, 0, 0, 0))
	_frames.clear()
	for i in range(entries.size()):
		var key: String = entries[i][0]
		var img: Image = entries[i][1]
		var p: Vector2i = places[i]
		atlas.blit_rect(img, Rect2i(Vector2i.ZERO, img.get_size()), p)
		var uv := Rect2(Vector2(p) / Vector2(atlas_w, atlas_h), Vector2(img.get_size()) / Vector2(atlas_w, atlas_h))
		if not _frames.has(key):
			_frames[key] = []
		(_frames[key] as Array).append({"uv": uv, "px": Rect2i(p, img.get_size()), "w": img.get_width(), "h": img.get_height()})
	_texture = ImageTexture.create_from_image(atlas)


static func _images_for(name: String, element: String) -> Array[Image]:
	var out: Array[Image] = []
	var override := "res://assets/sprites/%s.png" % name
	if ResourceLoader.exists(override):
		for path in [override, "res://assets/sprites/%s-2.png" % name]:
			if not ResourceLoader.exists(path):
				continue
			var tex: Texture2D = load(path)
			var img := tex.get_image()
			if img.is_compressed():
				img.decompress()
			img.convert(Image.FORMAT_RGBA8)
			if RECOLOR.has(name):
				_tint_neutral(img, element)
			out.append(img)
		return out
	if name == "player":
		out.append(_gen_player(0))
		out.append(_gen_player(1))
		return out
	var d: Dictionary = DEFS[name]
	if bool(d.get("procedural", false)):
		out.append(_gen_sylvarche(0))
		out.append(_gen_sylvarche(1))
		return out
	var pal: Dictionary = (d["pal"] as Dictionary).duplicate()
	if RECOLOR.has(name):
		var ec: Array = ELEM[element if ELEM.has(element) else "physique"]
		if not pal.has("o"):
			pal["o"] = ec[0]
		pal["d"] = ec[1]
		pal["m"] = ec[2]
		pal["l"] = ec[3]
	if not pal.has("o"):
		pal["o"] = "120e1a"
	var frames: Array = d["frames"] if d.has("frames") else (DEFS[str(d["base"])] as Dictionary)["frames"]
	for rows in frames:
		out.append(_rasterize(rows, pal))
	return out


## Parties en gris neutre -> rampe de couleurs de l'élément (noir : foncé, gris : principal, blanc : reflet).
static func _tint_neutral(img: Image, element: String) -> void:
	var ec: Array = ELEM[element if ELEM.has(element) else "physique"]
	var ramp := [Color(str(ec[0])), Color(str(ec[1])), Color(str(ec[2])), Color(str(ec[3]))]
	for y in range(img.get_height()):
		for x in range(img.get_width()):
			var c := img.get_pixel(x, y)
			if c.a <= 0.0 or c.s > 0.15:
				continue
			var v := c.v
			var out: Color
			if v < 0.3:
				out = (ramp[0] as Color).lerp(ramp[1], v / 0.3)
			elif v < 0.7:
				out = (ramp[1] as Color).lerp(ramp[2], (v - 0.3) / 0.4)
			else:
				out = (ramp[2] as Color).lerp(ramp[3], (v - 0.7) / 0.3)
			out.a = c.a
			img.set_pixel(x, y, out)


static func _rasterize(rows: Array, pal: Dictionary) -> Image:
	var h := rows.size()
	var w := 0
	for r in rows:
		w = maxi(w, str(r).length())
	var img := Image.create_empty(w, h, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	for y in range(h):
		var row := str(rows[y])
		for x in range(row.length()):
			var ch := row[x]
			if ch == "." or ch == " " or not pal.has(ch):
				continue
			img.set_pixel(x, y, Color(str(pal[ch])))
	return img


## Héros vu de dos, aux couleurs de sa tenue, avec sa coiffe et les traits de sa race.
static func _gen_player(frame: int) -> Image:
	var pal := PlayerLook.palette(_player_look, _player_race)
	var o: Array = pal["outfit"]
	var hr: Array = pal["hair"]
	var sk: Array = pal["skin"]
	var eyes: Color = pal["eyes"]
	var head := str(pal["head"])
	var hooded := head == "capuche"
	var rows: Array = [
		"..............g.",
		".............gwg",
		"......ooo.....g.",
		".....oHHHo....s.",
		"....oHHhhHo...s.",
		"....oHhhhhHo..s.",
		"....ohhhhhho.os.",
		"....ochhhhco.Cs.",
		"...ocCchhcCCoCCo",
		"...occCCCCCcCo..",
		"..occCCtCCCCcco.",
		"..occCCtCCCCcco.",
		"..ocbbbbbbbbbco.",
		"..occCCtCCCCcco.",
		"..occCCtCCCCCcco",
		"..occCCtCCCCCcco",
		"...occCtCCCCCcco",
		"...ocCctttttccco",
	]
	var legs_a := ["....okko.okko...", "....okko.okko...", "....oooo.oooo..."]
	var legs_b := ["...okko...okko..", "...okko...okko..", "...oooo...oooo.."]
	if int(pal["sil"]) == 1:
		# Cape et tunique : la robe s'arrête plus haut, les jambes se voient.
		rows[15] = "..occCCtCCCCCcco"
		rows[16] = "...occtttttccco."
		rows[17] = "....oLLo.oLLo..."
	rows.append_array(legs_a if frame == 0 else legs_b)
	if _player_class != "mage":
		# Le bâton du Mage cède la place à l'arme de la classe (dessinée plus bas).
		for y in range(0, 8):
			rows[y] = str(rows[y]).replace("g", ".").replace("w", ".").replace("s", ".")
	var w := 18
	var cmap := {
		"o": Color("0e0a1c"), "C": o[2], "c": o[1], "t": eyes, "b": Color("6a4a2a"), "s": Color("8a5a2b"),
		"g": eyes.lightened(0.4), "w": Color.WHITE, "k": Color("2a2030"), "L": o[0],
		"H": o[3] if hooded else hr[2], "h": o[2] if hooded else hr[1],
	}
	var img := Image.create_empty(w, rows.size() + 2, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	for y in range(rows.size()):
		var r := str(rows[y])
		for x in range(r.length()):
			var ch := r[x]
			if cmap.has(ch):
				img.set_pixel(x + 1, y + 2, cmap[ch])
	var put := func(x: int, y: int, c: Color) -> void:
		if x >= 0 and y >= 0 and x < w and y < img.get_height():
			img.set_pixel(x, y, c)
	# Cheveux longs ou tresse sur le dos.
	if head == "longs":
		for y in range(10, 15):
			for x in range(7, 12):
				put.call(x, y, hr[1] if (x + y) % 3 != 0 else hr[0])
	elif head == "tresse":
		for y in range(10, 18):
			put.call(9, y, hr[1] if y % 2 == 0 else hr[0])
			put.call(10, y, hr[0] if y % 2 == 0 else hr[1])
	match str(pal["trait"]):
		"ears":
			for q in [Vector2i(4, 6), Vector2i(3, 5), Vector2i(12, 6), Vector2i(13, 5)]:
				put.call(q.x, q.y, sk[1])
		"horns", "ghost":
			if str(pal["trait"]) == "horns":
				for q in [Vector2i(6, 4), Vector2i(5, 3), Vector2i(5, 2), Vector2i(10, 4), Vector2i(11, 3), Vector2i(11, 2)]:
					put.call(q.x, q.y, Color("e8dcc0"))
				for q in [Vector2i(3, 19), Vector2i(2, 20), Vector2i(1, 21), Vector2i(1, 22), Vector2i(0, 22)]:
					put.call(q.x, q.y, sk[1])
			else:
				# Revenant : ourlet effiloché.
				for x in [4, 7, 11, 14]:
					put.call(x, 19, Color(0, 0, 0, 0))
		"tail":
			for q in [Vector2i(3, 19), Vector2i(2, 20), Vector2i(1, 21), Vector2i(1, 22), Vector2i(0, 22), Vector2i(2, 21)]:
				put.call(q.x, q.y, sk[1])
		"wings":
			for y in range(8, 16):
				var span := 3 - absi(y - 11) / 2
				for k in range(span):
					put.call(2 - k, y, Color(0.85, 0.8, 1.0, 0.9) if k < span - 1 else Color("5a4a78"))
					put.call(15 + k, y, Color(0.85, 0.8, 1.0, 0.9) if k < span - 1 else Color("5a4a78"))
		"tusks":
			for q in [Vector2i(2, 15), Vector2i(16, 15)]:
				put.call(q.x, q.y, sk[1])
	_draw_weapon(put, _player_class, o, eyes)
	return img


## Arme du héros selon sa classe (étape 13.3), tenue dans la main droite (vers x 15, y 9).
static func _draw_weapon(put: Callable, cls: String, o: Array, eyes: Color) -> void:
	var wood := Color("8a5a2b")
	var steel := Color("d8dce8")
	var steel_d := Color("8a90a0")
	var gold := Color("e0b850")
	match cls:
		"archer":
			for q in [Vector2i(15, 1), Vector2i(16, 2), Vector2i(17, 3), Vector2i(17, 4), Vector2i(17, 5), Vector2i(17, 6), Vector2i(17, 7),
					Vector2i(17, 8), Vector2i(17, 9), Vector2i(17, 10), Vector2i(16, 11), Vector2i(15, 12)]:
				put.call(q.x, q.y, wood)
			for y in range(2, 12):
				put.call(15, y, Color(0.92, 0.92, 0.96, 0.85))
			put.call(14, 6, steel)
			put.call(13, 6, steel_d)
		"epeiste":
			for y in range(1, 9):
				put.call(16, y, steel if y > 1 else Color.WHITE)
				if y > 2:
					put.call(17, y, steel_d)
			for x in range(14, 18):
				put.call(x, 9, gold)
			put.call(16, 10, Color("5a3a22"))
			put.call(16, 11, gold)
		"clerc":
			for y in range(4, 14):
				put.call(16, y, Color("b08a40"))
			for q in [Vector2i(15, 1), Vector2i(16, 1), Vector2i(17, 1), Vector2i(15, 3), Vector2i(17, 3), Vector2i(15, 2), Vector2i(17, 2)]:
				put.call(q.x, q.y, gold)
			put.call(16, 2, Color("fff6c8"))
			put.call(16, 0, Color(1.0, 0.95, 0.7, 0.8))
			put.call(14, 2, Color(1.0, 0.95, 0.7, 0.6))
		"necromancien":
			for y in range(3, 14):
				put.call(16, y, Color("3a2a3a"))
			for q in [Vector2i(15, 1), Vector2i(16, 1), Vector2i(17, 1), Vector2i(15, 2), Vector2i(17, 2), Vector2i(16, 3)]:
				put.call(q.x, q.y, Color("e8dcc0"))
			put.call(16, 2, Color("8e62e0"))
			for q in [Vector2i(14, 0), Vector2i(13, 1), Vector2i(12, 2)]:
				put.call(q.x, q.y, steel_d)
		"chevalier":
			for y in range(7, 15):
				for x in range(13, 18):
					var edge := x == 13 or x == 17 or y == 7 or y == 14
					put.call(x, y, Color("a8b0c0") if edge else o[2])
			for y in range(8, 14):
				put.call(15, y, gold)
			for x in range(14, 17):
				put.call(x, 10, gold)
			for y in range(1, 7):
				put.call(17, y, steel)
		"berserker":
			for y in range(2, 14):
				put.call(16, y, Color("6a4a2a"))
			for q in [Vector2i(13, 2), Vector2i(14, 2), Vector2i(15, 2), Vector2i(12, 3), Vector2i(13, 3), Vector2i(14, 3), Vector2i(15, 3),
					Vector2i(12, 4), Vector2i(13, 4), Vector2i(14, 4), Vector2i(15, 4), Vector2i(13, 5), Vector2i(14, 5), Vector2i(15, 5)]:
				put.call(q.x, q.y, steel if q.x > 12 else Color.WHITE)
			put.call(17, 3, steel_d)
			put.call(17, 4, steel_d)


## Boss de la zone 1, dessiné par code : canopée corrompue, tronc à visage, bras-branches, racines.
static func _gen_sylvarche(frame: int) -> Image:
	var w := 34
	var h := 44
	var img := Image.create_empty(w, h, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = 77
	var sway := float(frame)
	var leaves := [Color("223a24"), Color("3f6a3a"), Color("6f9a4a"), Color("8fc05a")]
	for y in range(0, 24):
		for x in range(w):
			var dx := (float(x) - 16.5 - sway * 0.8) / 15.5
			var dy := (float(y) - 11.0) / 11.0
			var d := dx * dx + dy * dy + rng.randf_range(-0.14, 0.14)
			if d >= 1.0:
				continue
			var shade := 1
			if dx + (-dy) > 0.55:
				shade = 3 if d < 0.55 else 2
			elif dx < -0.35 or dy > 0.45:
				shade = 0
			var c: Color = leaves[shade]
			var r := rng.randf()
			if r < 0.06:
				c = Color("8e62e0")
			elif r < 0.08:
				c = Color("d93cf2")
			img.set_pixel(x, y, c)
	for y in range(17, 38):
		var half := 4 + int(float(y - 17) / 7.0)
		for x in range(17 - half, 17 + half):
			var c := Color("4a3424")
			if (x * 3 + y) % 7 == 0:
				c = Color("3a2818")
			if x >= 17 + half - 2:
				c = Color("6a4a30")
			if x <= 17 - half:
				c = Color("2e2016")
			img.set_pixel(x, y, c)
	var glow := Color("ff8af0") if frame == 0 else Color("d93cf2")
	for e in [Vector2i(13, 23), Vector2i(19, 23)]:
		img.set_pixel(e.x, e.y, Color("d93cf2"))
		img.set_pixel(e.x + 1, e.y, Color("d93cf2"))
		img.set_pixel(e.x, e.y + 1, glow)
		img.set_pixel(e.x + 1, e.y + 1, glow)
	for x in range(14, 21):
		img.set_pixel(x, 28, Color("1a0f0a"))
	img.set_pixel(15, 29, Color("1a0f0a"))
	img.set_pixel(19, 29, Color("1a0f0a"))
	var arm_l := Vector2i(2, 16 - frame)
	var arm_r := Vector2i(31, 15 + frame)
	_line(img, Vector2i(12, 26), arm_l, Color("4a3424"))
	_line(img, Vector2i(12, 27), arm_l + Vector2i(0, 1), Color("2e2016"))
	_line(img, Vector2i(22, 26), arm_r, Color("6a4a30"))
	_line(img, Vector2i(22, 27), arm_r + Vector2i(0, 1), Color("4a3424"))
	_line(img, arm_l, arm_l + Vector2i(-1, -3), Color("4a3424"))
	_line(img, arm_r, arm_r + Vector2i(1, -3), Color("6a4a30"))
	for i in range(6):
		var sx := 11 + i * 2
		_line(img, Vector2i(sx, 37), Vector2i(3 + i * 6 + frame, 43), Color("3a2818"))
	for i in range(14):
		var p := Vector2i(rng.randi_range(12, 22), rng.randi_range(18, 36))
		if img.get_pixel(p.x, p.y).a > 0.0:
			img.set_pixel(p.x, p.y, Color("8e62e0"))
	_outline(img, Color("0c100a"))
	return img


static func _line(img: Image, a: Vector2i, b: Vector2i, c: Color) -> void:
	var steps := maxi(absi(b.x - a.x), absi(b.y - a.y))
	for i in range(steps + 1):
		var t := float(i) / float(maxi(1, steps))
		var p := Vector2i(roundi(lerpf(a.x, b.x, t)), roundi(lerpf(a.y, b.y, t)))
		if p.x >= 0 and p.y >= 0 and p.x < img.get_width() and p.y < img.get_height():
			img.set_pixel(p.x, p.y, c)


static func _outline(img: Image, c: Color) -> void:
	var src := img.duplicate()
	for y in range(img.get_height()):
		for x in range(img.get_width()):
			if src.get_pixel(x, y).a > 0.0:
				continue
			for o in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]:
				var q: Vector2i = Vector2i(x, y) + o
				if q.x >= 0 and q.y >= 0 and q.x < img.get_width() and q.y < img.get_height() and src.get_pixel(q.x, q.y).a > 0.0:
					img.set_pixel(x, y, c)
					break
